<li>-</li>
<li><a href="/docs/install/">Installation</a></li>
<li><a href="/docs/">Dokumentation</a></li>
<li><a href="/news/">Neuigkeiten</a></li>
<li><a href="https://codeberg.org/libreboot/lbmk/issues">Bugs</a></li>
<li><a href="/tasks/">TODO</a></li>
<li><a href="/git.de.html">Patch senden</a></li>
<li><a href="/contact.de.html">Kontakt</a></li>
<li>-</li>
<li style="font-size:1.3em;"><em><strong><a href="https://www.patreon.com/libreleah">Spenden</a></strong></em></li>
</ul>
<hr/>
</header>
$endif$
$if(return)$
$return$
$endif$
$if(toc)$
<nav id="$idprefix$TOC">
<h1>Navigate this page:</h1>
$toc$
</nav>
$endif$
$if(toc)$
<div class="pagetext">
$endif$
$body$
$for(include-after)$
$include-after$
$endfor$
$if(toc)$
</div>
$endif$
</div>
</body>
</html>
